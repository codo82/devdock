{
  "name": "devdock",
  "version": "2.0.0-dev.0",
  "description": "Dashboard locale per sviluppatori: tunnel SSH, script npm, PM2, Git e anteprima Swagger",
  "private": true,
  "workspaces": [
    "extensions/*"
  ],
  "main": "server.js",
  "exports": {
    ".": "./server.js",
    "./testkit": "./lib/testkit.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "devdock": "bin/devdock.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "i18n:report": "node scripts/i18n-report.js",
    "ext": "node bin/devdock.js ext"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^4.18.2"
  }
}

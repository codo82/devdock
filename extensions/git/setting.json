{
  "name": "Git",
  "code": "git",
  "version": "1.0.0",
  "description": {
    "it": "Status, commit, grafo dei commit e operazioni remote per i repository dei progetti npm",
    "en": "Status, commits, commit graph and remote operations for the repositories of the npm projects"
  },
  "color": "#3fb950",
  "icon": "🌿",
  "position": "tab",
  "order": 30,
  "dependencies": [
    {
      "code": "npm",
      "required": true
    }
  ],
  "backend": {
    "module": "server.js",
    "routes": [
      { "method": "GET",   "path": "/repos",                  "handler": "listRepos" },
      { "method": "GET",   "path": "/repos/:id/status",       "handler": "status" },
      { "method": "GET",   "path": "/repos/:id/branches",     "handler": "branches" },
      { "method": "GET",   "path": "/repos/:id/merge-preview", "handler": "mergePreview" },
      { "method": "GET",   "path": "/repos/:id/log",          "handler": "log" },
      { "method": "GET",   "path": "/repos/:id/commit/:hash", "handler": "commitMessage" },
      { "method": "POST",  "path": "/repos/:id/action",       "handler": "action", "stream": true }
    ]
  },
  "frontend": {
    "html": "view.html",
    "sidebar": "sidebar.html",
    "js": "view.js",
    "css": "style.css"
  }
}

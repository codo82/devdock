{
  "name": "Database",
  "code": "db-client",
  "version": "1.0.0",
  "description": "Client MySQL/MariaDB: connessioni con password cifrate da una master password, query e risultati in tabella",
  "color": "#d29922",
  "icon": "🗄️",
  "position": "tab",
  "order": 25,
  "dependencies": [
    { "code": "tunnels", "required": false },
    { "code": "npm",     "required": false }
  ],
  "config": ["dbConnections", "vault"],
  "export": [
    { "id": "connections", "label": "Connessioni database", "description": "Connessioni e password cifrate (servono la stessa master password)", "sections": ["dbConnections", "vault"] }
  ],
  "backend": {
    "module": "server.js",
    "routes": [
      { "method": "GET",    "path": "/info",                  "handler": "info" },
      { "method": "GET",    "path": "/connections",           "handler": "listConnections" },
      { "method": "POST",   "path": "/connections",           "handler": "createConnection" },
      { "method": "PUT",    "path": "/connections/:id",       "handler": "updateConnection" },
      { "method": "DELETE", "path": "/connections/:id",       "handler": "deleteConnection" },
      { "method": "POST",   "path": "/connections/import",   "handler": "importConnections" },
      { "method": "POST",   "path": "/connections/:id/test",  "handler": "testConnection" },
      { "method": "GET",    "path": "/connections/:id/databases", "handler": "databases" },
      { "method": "GET",    "path": "/connections/:id/databases/:db/tables", "handler": "tables" },
      { "method": "GET",    "path": "/connections/:id/databases/:db/tables/:table", "handler": "tableInfo" },
      { "method": "POST",   "path": "/connections/:id/databases/:db/tables/:table/rows", "handler": "rows" },
      { "method": "POST",   "path": "/connections/:id/databases/:db/tables/:table/row", "handler": "row" },
      { "method": "POST",   "path": "/connections/:id/databases/:db/create-table", "handler": "createTable" },
      { "method": "POST",   "path": "/connections/:id/exports",  "handler": "createExport" },
      { "method": "GET",    "path": "/connections/:id/exports/:exportId", "handler": "downloadExport" },
      { "method": "POST",   "path": "/connections/:id/query",  "handler": "query" },
      { "method": "GET",    "path": "/vault",                 "handler": "vaultStatus" },
      { "method": "POST",   "path": "/vault/init",            "handler": "vaultInit" },
      { "method": "POST",   "path": "/vault/unlock",          "handler": "vaultUnlock" },
      { "method": "POST",   "path": "/vault/lock",            "handler": "vaultLock" },
      { "method": "POST",   "path": "/vault/change",          "handler": "vaultChange" },
      { "method": "POST",   "path": "/vault/reset",           "handler": "vaultReset" },
      { "method": "POST",   "path": "/vault/settings",        "handler": "vaultSettings" }
    ]
  },
  "frontend": {
    "html": "view.html",
    "sidebar": "sidebar.html",
    "js": "view.js",
    "css": "style.css"
  }
}

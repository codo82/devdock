{
  "name": { "it": "HTTP", "en": "HTTP" },
  "code": "http-client",
  "version": "1.0.0",
  "devdock": "^2.0",
  "description": {
    "it": "Client HTTP per le API locali dei progetti: sezioni di richieste con variabili, rotte Express trovate nel codice, token per tipologia di utenza (basic, login, OAuth/OpenID Connect)",
    "en": "HTTP client for the projects' local APIs: sections of requests with variables, Express routes found in the code, tokens per user type (basic, login, OAuth/OpenID Connect)"
  },
  "color": "#f778ba",
  "icon": "📮",
  "position": "tab",
  "order": 38,
  "dependencies": [
    { "code": "db-client", "required": false }
  ],
  "config": ["httpSections"],
  "export": [
    {
      "id": "sections",
      "label": { "it": "Richieste HTTP", "en": "HTTP requests" },
      "description": {
        "it": "Sezioni, richieste, variabili e tipologie di utenza (i segreti restano cifrati: serve la stessa master password)",
        "en": "Sections, requests, variables and user types (secrets stay encrypted: the same master password is needed)"
      },
      "sections": ["httpSections"]
    }
  ],
  "backend": {
    "module": "server.js",
    "routes": [
      { "method": "GET",    "path": "/info",                                 "handler": "info" },
      { "method": "GET",    "path": "/sections",                             "handler": "listSections" },
      { "method": "POST",   "path": "/sections",                             "handler": "createSection" },
      { "method": "PUT",    "path": "/sections/:id",                         "handler": "updateSection" },
      { "method": "DELETE", "path": "/sections/:id",                         "handler": "deleteSection" },
      { "method": "GET",    "path": "/base-url",                             "handler": "suggestBaseUrl" },
      { "method": "POST",   "path": "/sections/:id/requests",                "handler": "createRequest" },
      { "method": "PUT",    "path": "/sections/:id/requests/:rid",           "handler": "updateRequest" },
      { "method": "DELETE", "path": "/sections/:id/requests/:rid",           "handler": "deleteRequest" },
      { "method": "POST",   "path": "/sections/:id/users",                   "handler": "createUserType" },
      { "method": "PUT",    "path": "/sections/:id/users/:uid",              "handler": "updateUserType" },
      { "method": "DELETE", "path": "/sections/:id/users/:uid",              "handler": "deleteUserType" },
      { "method": "GET",    "path": "/sections/:id/auth",                    "handler": "authState" },
      { "method": "POST",   "path": "/sections/:id/users/:uid/token",        "handler": "setToken" },
      { "method": "DELETE", "path": "/sections/:id/users/:uid/token",        "handler": "forgetToken" },
      { "method": "POST",   "path": "/sections/:id/users/:uid/login",        "handler": "login" },
      { "method": "GET",    "path": "/sections/:id/routes",                  "handler": "discoverRoutes" },
      { "method": "POST",   "path": "/oidc-discovery",                       "handler": "oidcDiscovery" },
      { "method": "POST",   "path": "/send",                                 "handler": "send" }
    ]
  },
  "frontend": {
    "html": "view.html",
    "sidebar": "sidebar.html",
    "js": "view.js",
    "css": "style.css"
  }
}

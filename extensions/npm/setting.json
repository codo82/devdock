{
  "name": "NPM",
  "code": "npm",
  "version": "1.0.0",
  "description": {
    "it": "Progetti locali: script di package.json come processi tracciati, porte in ascolto, dipendenze e aggiornamenti",
    "en": "Local projects: package.json scripts as tracked processes, listening ports, dependencies and updates"
  },
  "color": "#f0883e",
  "icon": "📦",
  "position": "tab",
  "order": 20,
  "config": [
    "projects"
  ],
  "export": [
    {
      "id": "projects",
      "label": { "it": "Progetti NPM", "en": "NPM projects" },
      "description": { "it": "Cartelle dei progetti (usate anche da Git)", "en": "Project folders (also used by Git)" },
      "sections": [
        "projects"
      ]
    }
  ],
  "backend": {
    "module": "server.js",
    "routes": [
      { "method": "GET",     "path": "/projects",                        "handler": "listProjects" },
      { "method": "POST",    "path": "/projects",                        "handler": "createProject" },
      { "method": "PUT",     "path": "/projects/:id",                    "handler": "updateProject" },
      { "method": "DELETE",  "path": "/projects/:id",                    "handler": "deleteProject" },
      { "method": "GET",     "path": "/projects/:id/package",            "handler": "packageInfo" },
      { "method": "POST",    "path": "/projects/:id/installed-versions", "handler": "installedVersions" },
      { "method": "GET",     "path": "/projects/:id/outdated",           "handler": "outdated" },
      { "method": "POST",    "path": "/projects/:id/run",                "handler": "runScript" },
      { "method": "POST",    "path": "/projects/:id/update",             "handler": "updatePackage" },
      { "method": "GET",     "path": "/processes",                       "handler": "listProcesses" },
      { "method": "DELETE",  "path": "/processes/:id",                   "handler": "stopProcess" },
      { "method": "POST",    "path": "/processes/:id/restart",           "handler": "restartProcess" },
      { "method": "DELETE",  "path": "/processes/:id/dismiss",           "handler": "dismissProcess" },
      { "method": "GET",     "path": "/processes/:id/logs",              "handler": "processLogs" },
      { "method": "GET",     "path": "/processes/:id/stream",            "handler": "processStream", "stream": true }
    ]
  },
  "frontend": {
    "html": "view.html",
    "sidebar": "sidebar.html",
    "js": "view.js",
    "css": "style.css",
    "preload": true
  }
}

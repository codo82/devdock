{
  "name": "PM2",
  "code": "pm2",
  "version": "1.0.0",
  "devdock": "^2.0",
  "description": {
    "it": "Processi PM2: lista, start/stop/restart/delete e log in streaming",
    "en": "PM2 processes: list, start/stop/restart/delete and streaming logs"
  },
  "color": "#bc8cff",
  "icon": "⚙️",
  "position": "header",
  "order": 10,
  "dependencies": [
    {
      "code": "npm",
      "required": false
    }
  ],
  "backend": {
    "module": "server.js",
    "routes": [
      {
        "method": "GET",
        "path": "/list",
        "handler": "list"
      },
      {
        "method": "POST",
        "path": "/action",
        "handler": "action"
      },
      {
        "method": "GET",
        "path": "/logs",
        "handler": "logs",
        "stream": true
      }
    ]
  },
  "frontend": {
    "html": "view.html",
    "sidebar": "sidebar.html",
    "js": "view.js",
    "css": "style.css"
  },
  "mcp": {
    "tools": [
      {
        "name": "list",
        "handler": "list",
        "readOnly": true,
        "description": "List PM2 processes with status, pid, CPU %, memory (bytes), start time and restart count.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "logs",
        "handler": "logs",
        "readOnly": true,
        "description": "Last lines of the logs (stdout and stderr) of a PM2 process.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "PM2 process name or id"
            },
            "lines": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            }
          },
          "required": [
            "name"
          ]
        }
      }
    ]
  }
}

{
  "name": "Tunnels SSH",
  "code": "tunnels",
  "version": "1.0.0",
  "description": "Port forwarding SSH (ssh -L / autossh) per gruppi di server, con riconnessione automatica",
  "color": "#388bfd",
  "icon": "🔗",
  "position": "tab",
  "order": 10,
  "config": ["groups", "servers"],
  "backend": {
    "module": "server.js",
    "routes": [
      { "method": "GET",    "path": "/state",            "handler": "state" },
      { "method": "POST",   "path": "/tunnels",          "handler": "startTunnel" },
      { "method": "DELETE", "path": "/tunnels",          "handler": "stopAll" },
      { "method": "DELETE", "path": "/tunnels/:id",      "handler": "stopTunnel" },
      { "method": "GET",    "path": "/tunnels/:id/logs", "handler": "tunnelLogs" },
      { "method": "POST",   "path": "/groups",           "handler": "createGroup" },
      { "method": "PUT",    "path": "/groups/:key",      "handler": "updateGroup" },
      { "method": "DELETE", "path": "/groups/:key",      "handler": "deleteGroup" },
      { "method": "POST",   "path": "/servers",          "handler": "createServer" },
      { "method": "PUT",    "path": "/servers/:key",     "handler": "updateServer" },
      { "method": "DELETE", "path": "/servers/:key",     "handler": "deleteServer" }
    ]
  },
  "frontend": {
    "html": "view.html",
    "sidebar": "sidebar.html",
    "js": "view.js",
    "css": "style.css",
    "preload": true
  }
}
